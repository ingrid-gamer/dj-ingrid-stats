# ================================================================
# DJ PIXULA - VARIABLES DE ENTORNO
# Copia este archivo como .env
# ================================================================

SUPABASE_URL=https://TU-PROYECTO.supabase.co

# SOLO para scripts Node.js de backend/importación.
# No la pongas nunca en index.html.
# Puede ser la Secret Key actual de Supabase o la legacy service_role.
SUPABASE_SECRET_KEY=PEGA_AQUI_TU_SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY

# Credenciales de Spotify Developer para completar portadas y enlaces de álbum.
SPOTIFY_CLIENT_ID=PEGA_AQUI_TU_CLIENT_ID
SPOTIFY_CLIENT_SECRET=PEGA_AQUI_TU_CLIENT_SECRET
SPOTIFY_MARKET=CL

# Carpeta donde descomprimiste el Extended Streaming History.
SPOTIFY_HISTORY_DIR=./spotify-data

# Opcional
IMPORT_BATCH_SIZE=500
